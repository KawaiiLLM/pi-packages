{
  "name": "pi-agentflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "pnpm --filter @gotgenes/pi-subagents build:types && pnpm --filter @gotgenes/pi-permission-system build:types",
    "check": "pnpm build && pnpm --filter @gotgenes/pi-subagents check && pnpm --filter @gotgenes/pi-permission-system check && pnpm --filter pi-openai-toolkit typecheck && pnpm --filter pi-auto-mode check",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:integration": "pnpm --filter pi-auto-mode test:integration"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^24.12.4",
    "typescript": "^6.0.3"
  }
}
