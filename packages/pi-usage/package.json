{
	"name": "@narumitw/pi-usage",
	"version": "0.60.3",
	"description": "Pi extension that shows current-account usage and DeepSeek API balance for supported providers.",
	"type": "module",
	"license": "MIT",
	"private": true,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"usage",
		"quota",
		"balance",
		"deepseek",
		"fireworks",
		"baseten",
		"vercel-ai-gateway",
		"codex",
		"kimi",
		"kimi-coding",
		"moonshot",
		"moonshotai",
		"minimax",
		"token-plan",
		"copilot",
		"openrouter",
		"opencode",
		"zen",
		"zai",
		"glm",
		"xai",
		"grok"
	],
	"files": [
		"src",
		"dist",
		"docs",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/index.ts"
		]
	},
	"exports": {
		"./snapshot": "./src/snapshot.ts"
	},
	"scripts": {
		"test": "cd ../.. && vitest run --config vitest.status.config.ts packages/pi-usage/test",
		"build": "node scripts/build-runtime.mjs",
		"check": "npm run build && biome check --vcs-use-ignore-file=false src test scripts package.json tsconfig.json README.md && npm run typecheck",
		"format": "biome check --write --vcs-use-ignore-file=false src test scripts package.json tsconfig.json README.md",
		"typecheck": "tsc --noEmit",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@types/node": "^24.12.4",
		"esbuild": "0.28.2",
		"typescript": "^6.0.3"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "packages/pi-usage"
	},
	"dependencies": {
		"@narumitw/pi-tui-kit": "workspace:*"
	}
}
